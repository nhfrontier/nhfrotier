# NH 위드캔버스 운영 백엔드 환경변수 예시
#
# 값은 절대 이 파일에 적지 않는다. 키와 용도만 둔다.
# 실제 값은 컨테이너 환경변수 또는 Secret 저장소로 주입한다 (SECURITY C-2).
# 키를 추가하면 docs/architecture/DEPLOYMENT.md 3절도 함께 고친다.

# --- 실행 -------------------------------------------------------------------
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080
LOG_LEVEL=INFO

# --- PostgreSQL --------------------------------------------------------------
# 스키마는 기동 시 Flyway 가 적용한다. 별도 초기화 SQL 을 넣지 않는다.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=nhcanvas
DB_USER=nhcanvas
DB_PASSWORD=
DB_POOL_MAX=10

# --- 인증 --------------------------------------------------------------------
# dev = 요청 헤더의 사용자 식별자를 그대로 믿는다. 개발 전용이며 운영에서 쓰면 안 된다.
# sso = 사내 SSO 검증. 연계 방식이 확정되면 구현체를 추가한다 (08_DECISIONS 2절).
AUTH_PROVIDER=dev

# --- 파일 저장소 --------------------------------------------------------------
# 종류가 미결이라 인터페이스 뒤에 있다. local 은 디스크(NFS 마운트 포함).
# 컨테이너로 띄우면 이 경로에 볼륨이 필요하고, 여러 개를 띄우면 공유 마운트여야 한다.
FILE_STORAGE_TYPE=local
FILE_STORAGE_PATH=./var/storage
FILE_MAX_BYTES=52428800
FILE_MAX_SIZE=50MB

# --- 승인 LLM ----------------------------------------------------------------
# false 면 대역 응답으로 동작한다. 전체 흐름은 돌지만 AI 결과는 자리채움이다.
# endpoint 는 설정으로 고정한다. 사용자 입력이 호출 대상을 정하지 않는다 (SSRF).
# LLM_API_CREDENTIAL 은 로그·응답에 절대 싣지 않는다.
LLM_ENABLED=false
LLM_API_ENDPOINT=
LLM_API_CREDENTIAL=
LLM_MODEL_NAME=
LLM_TIMEOUT_SECONDS=120
LLM_MAX_INPUT_CHARS=400000

# --- 비동기 워커 --------------------------------------------------------------
# 큐는 DB 테이블이다. Redis 를 쓰지 않는다 (운영 용도가 미결).
WORKER_ENABLED=true
WORKER_POLL_INTERVAL_MS=2000
WORKER_MAX_ATTEMPTS=3
