# docker compose 용 설정. 이 파일을 .env 로 복사해 값을 채운다.
# 값은 절대 이 파일에 적지 않는다. .env 는 .gitignore 대상이다.

# --- 필수 ---
DB_PASSWORD=

# --- DB (기본값으로 충분하면 비워둔다) ---
DB_NAME=nhcanvas
DB_USER=nhcanvas

# --- 애플리케이션 ---
APP_VERSION=0.1.0
HOST_PORT=8080
SPRING_PROFILES_ACTIVE=dev
LOG_LEVEL=INFO

# dev = 헤더 기반 개발용 인증. 운영은 sso (구현 대기 중)
AUTH_PROVIDER=dev

FILE_MAX_BYTES=52428800

# --- LLM (행내 승인 endpoint 확정 전까지 false) ---
LLM_ENABLED=false
LLM_API_ENDPOINT=
LLM_API_CREDENTIAL=
LLM_MODEL_NAME=

WORKER_ENABLED=true
