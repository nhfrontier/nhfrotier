# 값은 절대 이 파일에 넣지 않는다. mockup/.env.local 에 채운다.

# Claude API 키. lib/generate.ts 에서 서버 측에서만 사용한다.
# NEXT_PUBLIC_ 접두사를 붙이면 브라우저 번들에 포함되므로 절대 붙이지 않는다.
ANTHROPIC_API_KEY=

# 팀 공유용 비밀번호 게이트. proxy.ts 가 /api 를 포함한 전 경로를 막는다.
# 비워두면 로컬 개발은 통과하지만, 배포본(NODE_ENV=production)은 503으로 막힌다.
PREVIEW_ACCESS_PASSWORD=

# Turso(libSQL) 접속 정보. SQLite 파일에서 전환한 뒤 사용한다.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
