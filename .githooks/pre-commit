#!/bin/sh
# 1) mockup-site/ 가 바뀐 커밋에서 공개 페이지가 깨질 참조를 검사한다.
# 2) 문서가 바뀐 커밋에서만 프로젝트문서.html 을 다시 만들고 같은 커밋에 포함한다.
# 활성화: node scripts/install-hooks.mjs
# 건너뛰기: SKIP_DOCS_BUILD=1 git commit ...
set -eu

[ "${SKIP_DOCS_BUILD:-}" = "1" ] && exit 0

# -z 로 읽어야 한글 경로가 "\352\260..." 로 quote되지 않는다.
STAGED=$(git diff --cached --name-only -z --diff-filter=ACMR | tr '\0' '\n')

# ── 공개 정적 목업 검사 ──
# mockup-site/ 는 GitHub Pages 로 그대로 서빙된다. 여기서 참조하는 이미지가
# .gitignore 대상이면 내 브라우저에서만 보이고 팀원에게는 404 가 된다.
SITE_CHANGED=$(printf '%s\n' "$STAGED" | grep -E '^mockup-site/' || true)

if [ -n "$SITE_CHANGED" ] && command -v node >/dev/null 2>&1; then
  if ! node scripts/check-pages-assets.mjs; then
    echo "pre-commit: 공개 페이지에서 깨질 참조가 있어 커밋을 중단합니다." >&2
    echo "            mockup-site/README.md 의 '왜 깨지나' 절을 볼 것." >&2
    exit 1
  fi
fi

# ── 문서 페이지 재생성 ──
CHANGED=$(printf '%s\n' "$STAGED" |
  grep -E '^(개발문서/|docs/|scripts/|design-systems/|MockupGen_기능명세서\.md$)' || true)

[ -z "$CHANGED" ] && exit 0

if ! command -v node >/dev/null 2>&1; then
  echo "pre-commit: node 를 찾을 수 없어 문서 페이지를 만들 수 없습니다." >&2
  echo "            건너뛰려면 SKIP_DOCS_BUILD=1 git commit ..." >&2
  exit 1
fi

if ! node scripts/build-fspec-changelog.mjs; then
  echo "pre-commit: 기능명세 변경 이력 갱신 실패 — 커밋을 중단합니다." >&2
  exit 1
fi

git add "개발문서/기능명세/00_CHANGELOG.md"

if ! node scripts/build-docs-site.mjs; then
  echo "pre-commit: 문서 페이지 생성 실패 — 커밋을 중단합니다." >&2
  exit 1
fi

git add 프로젝트문서.html
echo "pre-commit: 프로젝트문서.html 갱신 완료"
